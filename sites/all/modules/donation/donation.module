function donation_report_form_submit($form, &$form_state)
{
	if ( $form_state['input']['op'] == 'Sync to Tally' )
	{
		$domain =  str_replace(".dana.vridhamma.org", "", $_SERVER['HTTP_HOST']);
	     drupal_set_message("Synced to Tally. It will take a few minutes ... ");
	     chdir("/dhamma/web/domains/dana");
	     exec("nohup /usr/bin/php dump-to-tally.php ".$domain." &");
	}
	elseif ( $form_state['input']['op'] == 'Process Email Queue' )
	{
	    drupal_set_message("Email Queue Processed");
	    process_mail_queue();
	    //chdir("/dhamma/web/domains/donation");
	    //exec("nohup /usr/bin/php dump-to-tally.php &");
	}
	elseif ( $form_state['input']['op'] == 'Download Donor Master' )
	{
		$data = $form_state['input'];
		$params = array();
		$params['from'] = $data['r_from'];
		$params['to'] = $data['r_to'];
		$params['foreign'] = $data['r_foreign'];
		$params['category'] = $data['r_category'];
    $params['id_type'] = $data['r_id_type'];
		$params['txn_type'] = $data['r_type'];
    $params['don_tags'] = $data['r_tags'];
    $params['min_amount'] = $data['min_amount'];
    $params['max_amount'] = $data['max_amount'];
    $params['photo_id'] = $data['photo_id'];

    $params['synced'] = $data['synced'];
    $params['not_synced'] = $data['not_synced'];
    $params['deleted'] = $data['deleted'];
    $params['with_logs'] = $data['with_logs'];

	     download_donor_master($params);
	    //chdir("/dhamma/web/domains/donation");
	    //exec("nohup /usr/bin/php dump-to-tally.php &");
	}
	else
	{
    //var_dump($form_state['input']);
	    $form_state['storage'] = $form_state['input'];
	    $form_state['rebuild'] = TRUE;
	}
//	drupal_goto("donation-report-results", array('query' => $data));
}

function download_donor_master($params)
{
	global $user;
	require_once(drupal_get_path('module','donation')."/Classes/PHPExcel.php");	
	// F13 (donor versioning): stays LIVE (the current identity, D21), now with Donor ID and a per-row Check, and a
	// signed first line so the upload can refuse another centre's file (M7). Filters are bound (donation_report_where).
	$args = array();
	$q = "SELECT DISTINCT don.d_id AS 'Donor ID', don.d_name AS 'Name', don.d_contact AS 'Mobile', don.d_email AS 'Email',
		don.d_id_type AS 'it_code', it.it_name AS 'ID Type', don.d_id_no AS 'ID No'
		FROM dh_donation d LEFT JOIN dh_donor don ON d.d_donor = don.d_id LEFT JOIN users u ON d.d_createdBy = u.uid
		LEFT JOIN dh_donation_tag dt ON d.d_id = dt.dt_donation
		LEFT JOIN dh_id_types it ON (don.d_id_type = it.it_code)
		WHERE d.d_id > 0 AND d.d_deleted = '0' AND don.d_id IS NOT NULL" . donation_report_where($params, FALSE, 'num_or_f', $args) . "
		ORDER BY don.d_name, don.d_id";

	$data = array();
	$result = db_query($q, $args);
	if ($result->rowCount() > 0)
	{
		$tmpfname = tempnam(sys_get_temp_dir(), 'don-mas');
		$fp = fopen($tmpfname, 'w');
		$site = donation_site_key();
		$exported = donation_db_now();
		fputcsv($fp, array('#Dana Donor Master', 'site=' . $site, 'exported=' . $exported, 'sig=' . donor_master_sig($site, $exported)));
		fputcsv($fp, array('Full Name', 'Contact', 'Email', 'ID Type', 'ID No', 'Donor ID', 'Check'));
		$total_recs = $result->rowCount();
		while ( $row = $result->fetchAssoc() ) 
		{
			// L20: an unknown type is exported as UNKNOWN(n) and 0/'' as No ID (never "PAN")
			fputcsv($fp, array($row['Name'], $row['Mobile'], $row['Email'],
				donor_master_type_label($row['it_code'], $row['ID Type'], $row['ID No']), $row['ID No'], $row['Donor ID'],
				donor_master_row_check($row['Donor ID'], $row['it_code'], $row['ID No'])));
		}
		fclose($fp);
		header('Content-type: text/csv');
		header('Content-disposition:attachment; filename="Donor-Master.csv"');
		header('Cache-Control: max-age=0');
		// If you're serving to IE 9, then the following may be needed
		//header('Cache-Control: max-age=1');

		// If you're serving to IE over SSL, then the following may be needed
		header ('Expires: Mon, 26 Jul 1997 05:00:00 GMT'); // Date in the past
		header ('Last-Modified: '.gmdate('D, d M Y H:i:s').' GMT'); // always modified
		header ('Cache-Control: cache, must-revalidate'); // HTTP/1.1
		header ('Pragma: public'); // HTTP/1.0

		watchdog('donation', 'tmp file is '.$tmpfname, array(), WATCHDOG_NOTICE, 'link');
		readfile($tmpfname);
		exit();
	}
	else
	{
		drupal_set_message("No data found");
	}
}

function donation_report_xls()
{
	require_once(drupal_get_path('module','donation')."/Classes/PHPExcel.php");
	$start = $_REQUEST['start'];
	$end = $_REQUEST['end'];
	$category = $_REQUEST['category'];
  $id_type = $_REQUEST['id_type'];
	$txn_type = $_REQUEST['txn_type'];
  $don_tags = $_REQUEST['don_tags'];
	$foreign = $_REQUEST['foreign'];
	$course = $_REQUEST['course'];
	$receipt = str_replace( variable_get('receipt_prefix', ''), '' ,$_REQUEST['receipt']);
	$donor = $_REQUEST['name'];
	$r_user = $_REQUEST['user'];
  $min_amount = $_REQUEST['min_amount'];
  $max_amount = $_REQUEST['max_amount'];
  $photo_id = $_REQUEST['photo_id'];

  $synced = $_REQUEST['synced'];
  $not_synced = $_REQUEST['not_synced'];
  $deleted = $_REQUEST['deleted'];
  $with_logs = $_REQUEST['with_logs'];

	$txns = explode("\n", variable_get('txn_types', ""));
    $txn_types_qry = '';
    $txn_types_totals = array();
	foreach ($txns as $v) 
	{
		$t = explode("=", $v);
	    $txn_types_totals[] = trim($t[1]);
        $txn_types_qry .= "IF(d.d_type='".trim($t[0])."',d.d_amount,'') as '".trim($t[1])."', ";
	}

	// R8 (donor versioning): same columns and order as before; donor columns are those of each donation's
	// financial year (snapshot, else current). All filters are bound (donation_report_where).
	if (!donation_versioning_require(NULL, 'read'))
	{
		drupal_goto('donation-report');
		return;
	}
	$wdata = array('from' => $start, 'to' => $end, 'foreign' => $foreign, 'category' => $category, 'id_type' => $id_type,
		'txn_type' => $txn_type, 'don_tags' => $don_tags, 'course' => $course, 'receipt' => $receipt, 'name' => $donor,
		'user' => $r_user, 'min_amount' => $min_amount, 'max_amount' => $max_amount, 'photo_id' => $photo_id,
		'synced' => $synced, 'not_synced' => $not_synced, 'deleted' => $deleted, 'with_logs' => $with_logs);
	$args = array();
	$q = "SELECT d.d_date AS 'Txn Date', c.c_type AS 'Course',
		COALESCE(dv.dv_name, don.d_name) AS 'Full Name', COALESCE(dv.dv_address, don.d_address) AS 'Address',
		COALESCE(dv.dv_city, ci.c_city) AS 'City', COALESCE(dv.dv_state, st.s_name) AS 'State',
		COALESCE(dv.dv_pincode, don.d_pincode) AS 'Pin', COALESCE(dv.dv_country, cy.c_name) AS 'Country',
		COALESCE(dv.dv_contact, don.d_contact) AS 'Mobile', d.d_type AS 'Txn Type', d.d_category AS 'Category',
		d.d_receipt_f AS 'Receipt No', COALESCE(dv.dv_id_type_name, dit.it_name) AS 'ID Type',
		COALESCE(dv.dv_id_no, don.d_id_no) AS 'Passport/ID',
		$txn_types_qry
		IF(d.d_ref_no <> '', CONCAT(' ', d.d_ref_no), '') AS 'Ref No', d.d_currency AS 'Currency', IF(d.d_foreign,'Yes','') AS 'Foreign',
		d.d_comment AS 'Comment', COALESCE(dv.dv_email, don.d_email) AS 'Email', u.name AS 'CreatedBy', d.d_created AS 'Created On'
		FROM dh_donation d LEFT JOIN dh_donor don ON d.d_donor = don.d_id" . donation_donor_fy_join('d') . "
		LEFT JOIN users u ON d.d_createdBy = u.uid
		LEFT JOIN dh_city ci ON don.d_city = ci.c_id LEFT JOIN dh_state st ON (don.d_state = st.s_code AND don.d_country = st.s_country)
		LEFT JOIN dh_country cy ON don.d_country = cy.c_code LEFT JOIN dh_course c ON d.d_course = c.c_id
		LEFT JOIN dh_donation_tag dt ON d.d_id = dt.dt_donation LEFT JOIN dh_id_types dit ON dit.it_code = don.d_id_type
		WHERE d.d_deleted = '0'" . donation_report_where($wdata, TRUE, 'id', $args) . "
		ORDER BY d.d_created DESC";

	$result = db_query($q, $args);
	//drupal_set_message($q);

	$xls = new PHPExcel();
	$xls->setActiveSheetIndex(0);
	$xls->getActiveSheet()->setTitle('New Sheet');
   	$filename = "Donation-Report-".$start."-to-".$end.".xls";

	if ($result->rowCount() > 0)
	{
		$total_recs = $result->rowCount();
		$headers_done = false;
		$rows = array();
		$line = 2;
		while ( $row = $result->fetchAssoc() ) 
		{
			if (! $headers_done )
			{
				$headers = array_keys($row);
				$headers_done = true;
				$xls->getActiveSheet()->fromArray($headers, NULL, 'A1');
			}
			//$row['Receipt No'] = $row['']; //variable_get('receipt_prefix', '').str_pad($row['Receipt No'], 7, "0", STR_PAD_LEFT);

			if ( $row['Course'] == '' )
				$row['Course'] = 'Non Course';

			//$temp = explode(" ", $row['First Name']);
			/*$row['First Name'] = $temp[0];
			if (isset($temp[1]))
				$row['Last Name'] = $temp[1];
			*/

            foreach( $txn_types_totals as $t )
            {
                    if ( ! isset($totals[ $t ][$row['Currency']]) )
                            $totals[ $t ][$row['Currency']] = 0;
                    if (is_numeric($row[$t]))
                    	$totals[ $t ][$row['Currency']] += $row[ $t ];
            }

			/*if ( ! isset($totals['Cash'][$row['Currency']]) )
				$totals['Cash'][$row['Currency']] = 0;
			if ( ! isset($totals['Cheque'][$row['Currency']]) )
				$totals['Cheque'][$row['Currency']] = 0;
			if ( ! isset($totals['Card'][$row['Currency']]) )
				$totals['Card'][$row['Currency']] = 0;
			if ( ! isset($totals['Bank Transfer'][$row['Currency']]) )
				$totals['Bank Transfer'][$row['Currency']] = 0;

			$totals['Cash'][$row['Currency']] += $row['Cash'];
			$totals['Cheque'][$row['Currency']] += $row['Cheque'];
			$totals['Card'][$row['Currency']] += $row['Card'];
			$totals['Bank Transfer'][$row['Currency']] += $row['Bank Transfer'];
			*/

			$vals = array_values($row);
			$xls->getActiveSheet()->fromArray($vals,NULL, 'A'.$line);
			$line++;
		}
		$row = array();
		$grand_total = array();
		foreach( $headers as $v )
		{
			if( in_array($v, $txn_types_totals)) // array('Cash','Cheque','Card', 'Bank Transfer')
			{
				$temp = '';
				foreach($totals[$v] as $cur => $tot)
				{
					if ($tot > 0)
					{
						$temp .= number_format($tot).' '.$cur."\n";
                                                if ( !isset($grand_total[ $cur ]) )
                                                     $grand_total[ $cur ] = 0;
                                                 $grand_total[ $cur ] += $tot;
					}
				}
				$row[] = $temp;
			}
			else
				$row[] = NULL;
		}
		$temp = '';
		foreach( $grand_total as $cur => $total )
		   $temp .= number_format($total).' '.$cur."\n";
		$xls->getActiveSheet()->fromArray($row,NULL, 'A'.$line);
		$xls->getActiveSheet()->setCellValue('F'.($line+1), 'Grand Total:');
		$xls->getActiveSheet()->setCellValue('G'.($line+1), trim($temp));
		//$line++;

	}
	else
		$xls->getActiveSheet()->setCellValue('A1', 'No Transactions Found!');

	//$objWriter->save();

	/* Formatting Excel */
	$xls->getActiveSheet()->getColumnDimension('A')->setWidth(10);
	$xls->getActiveSheet()->getColumnDimension('B')->setWidth(9);
	$xls->getActiveSheet()->getColumnDimension('C')->setWidth(20);
	//$xls->getActiveSheet()->getColumnDimension('D')->setWidth(10);
	$xls->getActiveSheet()->getColumnDimension('D')->setWidth(20);
	$xls->getActiveSheet()->getColumnDimension('E')->setWidth(12);
	$xls->getActiveSheet()->getColumnDimension('F')->setWidth(12);
	$xls->getActiveSheet()->getColumnDimension('G')->setWidth(8);
	$xls->getActiveSheet()->getColumnDimension('H')->setWidth(8);
	$xls->getActiveSheet()->getColumnDimension('I')->setWidth(12);
	$xls->getActiveSheet()->getColumnDimension('J')->setWidth(12);
	$xls->getActiveSheet()->getColumnDimension('K')->setWidth(15);
	$xls->getActiveSheet()->getColumnDimension('L')->setWidth(12);
	$xls->getActiveSheet()->getColumnDimension('M')->setWidth(15);
	$xls->getActiveSheet()->getColumnDimension('N')->setWidth(15);
	$end = chr(ord('O')+count($txn_types_totals)-1);
	$xls->getActiveSheet()->getColumnDimension('O:'.$end)->setWidth(7);
	if ( (ord($end)+1) <= 90 )
		$xls->getActiveSheet()->getColumnDimension(chr(ord($end)+1) )->setWidth(20);
	if ( (ord($end)+2) <= 90 )
		$xls->getActiveSheet()->getColumnDimension(chr(ord($end)+2) )->setWidth(7);
	if ( (ord($end)+3) <= 90 )
		$xls->getActiveSheet()->getColumnDimension(chr(ord($end)+3) )->setWidth(7);
	if ( (ord($end)+4) <= 90 )
		$xls->getActiveSheet()->getColumnDimension(chr(ord($end)+4) )->setWidth(10);
	if ( (ord($end)+5) <= 90 )
		$xls->getActiveSheet()->getColumnDimension(chr(ord($end)+5) )->setWidth(25);
	if ( (ord($end)+6) <= 90 )
		$xls->getActiveSheet()->getColumnDimension(chr(ord($end)+6) )->setWidth(20);	

	$header = array('font' => array('bold' => true));
	$xls->getActiveSheet()->getStyle('A1:AA1')->applyFromArray($header);

	$style_amount = array('alignment' => array('horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_RIGHT));
	$xls->getActiveSheet()->getStyle('O2:T'.$line)->applyFromArray($style_amount);

	$style_total = array('alignment' => array('horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_RIGHT), 'font' => array('bold' => true));
	$xls->getActiveSheet()->getStyle('A'.$line.':AA'.$line)->applyFromArray($style_total);
	$xls->getActiveSheet()->getStyle('A'.$line.':AA'.$line)->getAlignment()->setWrapText(true);
	$xls->getActiveSheet()->getRowDimension(($line))->setRowHeight(50);

	$style_grand_total = array('alignment' => array('horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_RIGHT), 'font' => array('bold' => true, 'size' => 15));
	$xls->getActiveSheet()->getStyle('F'.($line+1).':G'.($line+1))->applyFromArray($style_grand_total);
	$xls->getActiveSheet()->getStyle('G'.($line+1))->getAlignment()->setWrapText(true);
	$xls->getActiveSheet()->getRowDimension(($line+1))->setRowHeight(50);
	$xls->getActiveSheet()->mergeCells('G'.($line+1).':I'.($line+1));

	$styleArray = array(
	    'font' => array(
	        'bold' => true,
	    ),
	    'alignment' => array(
	        'horizontal' => PHPExcel_Style_Alignment::HORIZONTAL_RIGHT,
	    ),
	    'borders' => array(
	        'top' => array(
	            'style' => PHPExcel_Style_Border::BORDER_THIN,
	        ),
	    ),
	    'fill' => array(
	        'type' => PHPExcel_Style_Fill::FILL_GRADIENT_LINEAR,
	        'rotation' => 90,
	        'startcolor' => array(
	            'argb' => 'FFA0A0A0',
	        ),
	        'endcolor' => array(
	            'argb' => 'FFFFFFFF',
	        ),
	    ),
	);



	header('Content-Type: application/vnd.ms-excel');
	header('Content-Disposition: attachment;filename="'.$filename.'"');
	header('Cache-Control: max-age=0');
	// If you're serving to IE 9, then the following may be needed
	//header('Cache-Control: max-age=1');

	// If you're serving to IE over SSL, then the following may be needed
	header ('Expires: Mon, 26 Jul 1997 05:00:00 GMT'); // Date in the past
	header ('Last-Modified: '.gmdate('D, d M Y H:i:s').' GMT'); // always modified
	header ('Cache-Control: cache, must-revalidate'); // HTTP/1.1
	header ('Pragma: public'); // HTTP/1.0

	$objWriter = PHPExcel_IOFactory::createWriter($xls, 'Excel5');
	$objWriter->save('php://output');	
}


// Upload CSV (course and student list) and Upload Donor Master (bulk ID correction): two steps, see upload-check.inc.
// Step 1 checks the whole file and writes nothing; step 2 ("Use this file") is offered only when the file has no problems.
function donation_upload_form($form, &$form_state)
{
	if (isset($form_state['storage']['check']))
	{
		dana_upload_review($form, $form_state['storage']['check'], 'csv');
		return $form;
	}
	$form['dana_help'] = array('#markup' => dana_help_link('upload-csv'), '#weight' => -100);
	$form['intro'] = array('#markup' => '<p>' . t('Add the students of a course to Dana, so they can be found on the donation form. '
		. 'Use the template: one line for each student, with the 14 columns in the same order.') . ' '
		. l(t('Download the template'), 'admin/upload-csv/template') . '</p><p>'
		. t('Dana first checks the whole file and shows every problem. Nothing is changed until the file has no problems and you click Use this file.') . '</p>');
	$form['upload'] = array('#type' => 'file', '#title' => t('CSV File'), '#description' => t('Course/Student data in CSV format'));
	$form['check'] = array('#type' => 'submit', '#value' => t('Check file'), '#validate' => array('dana_upload_file_validate'),
		'#submit' => array('donation_csv_check_submit'));
	$form['#attributes']['enctype'] = 'multipart/form-data';
	return $form;
}

function donation_csv_check_submit($form, &$form_state)
{
	$file = $form_state['values']['upload'];
	$form_state['storage'] = array('uri' => $file->uri, 'check' => donation_csv_check($file->uri));
	$form_state['rebuild'] = TRUE;
}

function donation_csv_use($form, &$form_state)
{
	$res = donation_csv_check($form_state['storage']['uri']);      // checked again just before it is used
	if ($res['errors'])
	{
		$form_state['storage']['check'] = $res;
		$form_state['rebuild'] = TRUE;
		return;
	}
	drupal_set_message(donation_csv_apply($res));
	$form_state['storage'] = array();
	$form_state['rebuild'] = TRUE;
}

function donation_donor_upload_form($form, &$form_state)
{
	if (isset($form_state['storage']['check']))
	{
		dana_upload_review($form, $form_state['storage']['check'], 'master');
		return $form;
	}
	$note = donor_apr_may_note();
	if ($note !== '')
		$form['apr_may_note'] = array('#markup' => '<div class="messages warning">' . check_plain($note) . '</div>');
	$form['dana_help'] = array('#markup' => dana_help_link('donor-master', 'upload'), '#weight' => -100);
	$form['intro'] = array('#markup' => '<p>' . t('Correct the ID Type and ID No of many donors at once: download the Donor Master from the report, '
		. 'change only the ID Type and ID No columns, and upload the file here.') . '</p><p>'
		. t('Dana first checks the whole file and shows every problem. Nothing is changed until the file has no problems and you click Use this file.') . '</p>');
	$form['upload'] = array(
	    '#type' => 'file',
	    '#title' => t('CSV File'),
	    '#description' => t('Upload the file downloaded with "Download Donor Master" from this centre. Files without the first signature line are matched by name + contact + email. Valid ID Types are PAN, Aadhaar, Passport, Voter ID, Driving License, Ration Card, No ID'),
	);
	$form['check'] = array('#type' => 'submit', '#value' => t('Check file'), '#validate' => array('dana_upload_file_validate'),
		'#submit' => array('donor_master_check_submit'));
	$form['#attributes']['enctype'] = 'multipart/form-data';
	return $form;
}

function donor_master_check_submit($form, &$form_state)
{
	$file = $form_state['values']['upload'];
	$form_state['storage'] = array('uri' => $file->uri, 'check' => donor_master_check($file->uri));
	$form_state['rebuild'] = TRUE;
}

function donor_master_use($form, &$form_state)
{
	$res = donor_master_check($form_state['storage']['uri']);      // checked again just before it is used
	if ($res['errors'])
	{
		$form_state['storage']['check'] = $res;
		$form_state['rebuild'] = TRUE;
		return;
	}
	drupal_set_message(donor_master_apply($res));
	$form_state['storage'] = array();
	$form_state['rebuild'] = TRUE;
}


function donation_income_tax_form($form, &$form_state)
{
	$form['dana_help'] = array('#markup' => dana_help_link('10bd'), '#weight' => -100);
	// R16x (donor versioning): review list of donors whose year details differ from the current record.
	if (donation_versioning_ready('read'))
		donation_10bd_review_form_parts($form, $form_state);
	$years  = array('' => 'Choose');
	$q = "select DISTINCT(date_format(d_date, '%Y')) as 'year' from dh_donation order by d_date asc";
	$hand = db_query($q);
	$year=0;
	while( $row = $hand->fetchAssoc() )
	{
		$years[$row['year']] = ($row['year'] - 1).' - '.$row['year'];
		$year=$row['year'];
	}
	if($year>0)
	{
		$month = date('m');
		if($month > 3)
		{
			$years[$year + 1] = $year.' - '.($year + 1);
		} 
	}

	$form['financial_year'] =  array('#type' => 'select', '#title' => 'Select Financial Year', '#options' => $years, '#required' => 1);

    $form['quarter'] = array(
        '#type' => 'select',
        '#title' => t('Quarter'),
        '#options' => array(
        ''   => t('Choose'),
        'Q1' => 'Q1 (Apr - Jun)',
        'Q2' => 'Q2 (Jul - Sep)',
        'Q3' => 'Q3 (Oct - Dec)',
        'Q4' => 'Q4 (Jan - Mar)',
        ),
        );

    $form['month'] = array(
        '#type' => 'select',
        '#title' => t('Month'),
        '#options' => array(
        ''   => t('Choose'),
        '04' => 'April',
        '05' => 'May',
        '06' => 'June',
        '07' => 'July',
        '08' => 'August',
        '09' => 'September',
        '10' => 'October',
        '11' => 'November',
        '12' => 'December',
        '01' => 'January',
        '02' => 'February',
        '03' => 'March',
        ),
        );

	$form['sub'] = array('#type' => 'submit', '#value' => 'Download Annual 10BD', '#prefix' => '<br/>Registration No and Date of Issuance can be setup in Settings.<br/>Donations marked as Foreign are not included.<br/>');

    $form['download_quarter'] = array(
        '#type' => 'submit',
        '#value' => t('Download Quarterly 10BD'),
        '#validate' => array('donation_income_tax_quarter_validate'),
        '#submit' => array('donation_income_tax_download_quarter_submit'),
        );

    $form['download_month'] = array(
        '#type' => 'submit',
        '#value' => t('Download Monthly 10BD'),
        '#validate' => array('donation_income_tax_month_validate'),
        '#submit' => array('donation_income_tax_download_month_submit'),
        );

	return $form;
}

function donation_income_tax_month_validate($form, &$form_state) {
  if (empty($form_state['values']['month'])) {
    form_set_error('month', t('Please select a month.'));
  }
}

function donation_income_tax_quarter_validate($form, &$form_state) {
  if (empty($form_state['values']['quarter'])) {
    form_set_error('quarter', t('Please select a quarter.'));
  }
}

function donation_income_tax_form_submit($form, &$form_state)
{
	//drupal_set_message("I am called");
	generate_10bd( $form_state['input']['financial_year'] );
}

function donation_income_tax_download_quarter_submit($form, &$form_state)
{
    generate_10bd( $form_state['input']['financial_year'], $form_state['values']['quarter'] );
}

function donation_income_tax_download_month_submit($form, &$form_state)
{
    generate_10bd( $form_state['input']['financial_year'], '', $form_state['values']['month'] );
}

function sanitize_10bd( $data )
{
	$ret = trim(preg_replace('/[^A-Za-z0-9\-,\. ]/', '', $data));
	return trim($ret, ",.-");
}

function generate_10bd( $year, $quarter = '', $month = '' )
{
    // HEAD concatenated the raw POSTed year into the SQL: force numbers / known values (R9).
    $year = (int) $year;
    $month = (int) $month;
    if (!in_array($quarter, array('', 'Q1', 'Q2', 'Q3', 'Q4'), TRUE))
        $quarter = '';
    if (!donation_versioning_require(NULL, 'read'))
    {
        drupal_goto('income-tax-report');
        return;
    }
    if (!empty($month)) {
        // Monthly
        $fy_start = $year - 1;

        // Jan-Mar belong to the ending calendar year of the FY.
        $calendar_year = ($month >= 4) ? $fy_start : $year;

        $start_date = sprintf('%04d-%02d-01', $calendar_year, $month);
        $end_date = date('Y-m-t', strtotime($start_date));
    }
    elseif (!empty($quarter)) {
        // Quarterly
        switch ($quarter) {
            case 'Q1':
                $start_date = ($year - 1) . '-04-01';
                $end_date   = ($year - 1) . '-06-30';
                break;

            case 'Q2':
                $start_date = ($year - 1) . '-07-01';
                $end_date   = ($year - 1) . '-09-30';
                break;

            case 'Q3':
                $start_date = ($year - 1) . '-10-01';
                $end_date   = ($year - 1) . '-12-31';
                break;

            case 'Q4':
                $start_date = $year . '-01-01';
                $end_date   = $year . '-03-31';
                break;
        }
    }
    else {
        // Annual
        $start_date = ($year - 1) . '-04-01';
        $end_date   = $year . '-03-31';
    }

     $urn = variable_get('10bd_registration_no', '');
     $urn_date = variable_get('10bd_registration_date', '');

     $id_codes = array(1 => 'Permanent Account Number', 2 => 'Aadhaar Number', 3 => 'Tax Identification Number', 4 => 'Passport number', 5 => "Elector's photo identity number", 6 => 'Driving License number', 7 => 'Ration card number' );

  // R9 (donor versioning): the donor details of each donation's financial year (snapshot, else current).
  $q = "SELECT 1 AS 'Sl. No.', '' AS 'Pre Acknowledgement Number',
    COALESCE(dv.dv_id_type, don.d_id_type) AS 'ID Code',
    COALESCE(dv.dv_id_no, don.d_id_no) AS 'Unique Identification Number',
    'Section 80G' AS 'Section Code', :urn AS 'Unique Registration Number (URN)',
    :urn_date AS 'Date of Issuance of Unique Registration Number',
    COALESCE(dv.dv_name, don.d_name) AS 'Name of donor',
    CONCAT(IFNULL(COALESCE(dv.dv_address, don.d_address), ''), ', ', IFNULL(COALESCE(dv.dv_city, c.c_city), ''), ', ',
           IFNULL(COALESCE(dv.dv_state, s.s_name), ''), ', pin - ', IFNULL(COALESCE(dv.dv_pincode, don.d_pincode), '')) AS 'Address of donor',
    d.d_category,
    (CASE WHEN d.d_type = 'cash' THEN 'Cash' WHEN d.d_type = 'kind' THEN 'Kind'
          ELSE 'Electronic modes including account payee cheque/draft' END) AS 'Mode of receipt',
    SUM(d.d_amount) AS 'Amount of donation (Indian rupees)'
    FROM dh_donation d
    LEFT JOIN dh_donor don ON (d.d_donor = don.d_id)" . donation_donor_fy_join('d') . "
    LEFT JOIN dh_city c ON (don.d_city = c.c_id)
    LEFT JOIN dh_state s ON (don.d_state = s.s_code AND don.d_country = s.s_country)
    WHERE d.d_date >= :start AND d.d_date <= :end
      AND COALESCE(dv.dv_id_type, don.d_id_type) BETWEEN 1 AND 7
      AND d.d_deleted = '0' AND d.d_foreign = '0'
    GROUP BY COALESCE(dv.dv_id_no, don.d_id_no), COALESCE(dv.dv_id_type, don.d_id_type), COALESCE(dv.dv_name, don.d_name), d.d_category,
      (CASE WHEN d.d_type = 'cash' THEN 'cash' WHEN d.d_type = 'kind' THEN 'kind' ELSE 'electronic' END)
    ORDER BY COALESCE(dv.dv_name, don.d_name), COALESCE(dv.dv_id_no, don.d_id_no), COALESCE(dv.dv_id_type, don.d_id_type), d.d_category,
      (CASE WHEN d.d_type = 'cash' THEN 'cash' WHEN d.d_type = 'kind' THEN 'kind' ELSE 'electronic' END)";   // total order: re-downloads are identical

	$result = db_query($q, array(':urn' => (string) $urn, ':urn_date' => (string) $urn_date, ':start' => $start_date, ':end' => $end_date));
	$header = array('Sl. No.', 'Pre Acknowledgement Number', 'ID Code', 'Unique Identification Number', 'Section Code', 'Unique Registration Number (URN)', 'Date of Issuance of Unique Registration Number', 'Name of donor', 'Address of donor', 'Donation Type', 'Mode of receipt', 'Amount of donation (Indian rupees)');
	$fname = tempnam(sys_get_temp_dir(), "it10bd");
	$fp = fopen($fname, "w");
	fputcsv($fp, $header);
	$serial = 1;
	while($row = $result->fetchAssoc())
	{
		$row['Sl. No.'] = $serial++;
		if ( strstr( strtolower($row['d_category']), "corpus") )
			$row['d_category'] = 'Corpus';
		elseif (strstr( strtolower($row['d_category']), "general") || (strstr( strtolower($row['d_category']), "others")) )
			$row['d_category'] = 'Others';
		else
			$row['d_category'] = 'Specific grant';
		$row['Name of donor'] = sanitize_10bd($row['Name of donor']);
		$row['Address of donor'] = trim(sanitize_10bd($row['Address of donor']));
		$row['ID Code'] = $id_codes[$row['ID Code']];
		fputcsv($fp, $row);
	}
	fclose($fp);

	header("Content-Type: text/csv");
	header('Content-disposition:attachment; filename="ITR-10BD-'.$year.'.csv"');
	header('Cache-Control: max-age=0');
	// If you're serving to IE 9, then the following may be needed
	//header('Cache-Control: max-age=1');

	// If you're serving to IE over SSL, then the following may be needed
	header ('Expires: Mon, 26 Jul 1997 05:00:00 GMT'); // Date in the past
	header ('Last-Modified: '.gmdate('D, d M Y H:i:s').' GMT'); // always modified
	header ('Cache-Control: cache, must-revalidate'); // HTTP/1.1
	header ('Pragma: public'); // HTTP/1.0
	readfile($fname);
	unlink($fname);
	exit();
}

function download_receipt( $donation_id )
{
	global $base_url;
	$row = db_query("select d_receipt, d_receipt_f, d_deleted, d_comment from dh_donation where d_id = :id", array(':id' => $donation_id))->fetchAssoc();
	$f = $row['d_receipt'];
	$fname = str_replace('private://', '', $f);
	if (  substr($fname,0,8) == 'receipts' )
		$fname = str_replace(array('https://', 'http://', '.dana.vridhamma.org'), '', $base_url)."/".$fname;
	$data = s3_get_file('vri-dana', $fname, 'stream');

	// A cancelled receipt is only ever served stamped CANCELLED; the copy in S3 stays as issued.
	if ( $data['success'] && ($row['d_deleted'] == '1') )
	{
		$data['data'] = donation_cancel_stamp_pdf($data['data'], $row['d_receipt_f'], donation_cancel_reason($row['d_comment']));
		if ($data['data'] === FALSE)
			return t('The cancelled receipt could not be prepared. Please try again later.');
	}

	header("Content-Type: application/pdf");
	header('Content-disposition:inline; filename="'.basename($f).'"');
	header('Cache-Control: private');
	// If you're serving to IE 9, then the following may be needed
	//header('Cache-Control: max-age=1');
	if (!$data['success'])
		watchdog('S3Debug', print_r($data, true));
	print($data['data']);
	exit();

}

/**
 * Upload the donation's receipt PDF to WhatsApp (360dialog) and return the media id, or 0.
 * On failure $error gets a short, staff-readable reason.
 */
function upload_whatsapp_pdf( $donation_id, &$error = NULL )
{
	global $base_url;
	$error = '';
	$q = "select d_receipt_email from dh_donation where d_id=".(int) $donation_id;
	$f = db_query($q)->fetchField();
	$fname = str_replace('private://', '', $f);
	if (  substr($fname,0,8) == 'receipts' )
		$fname = str_replace(array('https://', 'http://', '.dana.vridhamma.org'), '', $base_url)."/".$fname;
	$data = s3_get_file('vri-dana', $fname, 'file');
	if (empty($data['success']) || empty($data['data']) || !is_file($data['data']))
	{
		watchdog('S3Debug', print_r($data, true));
		$error = 'the receipt PDF could not be fetched from storage';
		return 0;
	}

	$id = 0;
	try {
		$curl = curl_init();

		curl_setopt_array($curl, array(
		  CURLOPT_URL => variable_get('whatsapp_url', '').'/media',
		  CURLOPT_RETURNTRANSFER => true,
		  CURLOPT_ENCODING => '',
		  CURLOPT_MAXREDIRS => 10,
		  CURLOPT_CONNECTTIMEOUT => 10,
		  CURLOPT_TIMEOUT => 60,
		  CURLOPT_FOLLOWLOCATION => true,
		  CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
		  CURLOPT_CUSTOMREQUEST => 'POST',
		  CURLOPT_POSTFIELDS => array('messaging_product'=>'whatsapp','file'=> new CURLFILE($data['data'], "application/pdf")),
		  CURLOPT_HTTPHEADER => array(
		    'D360-Api-Key: '.variable_get('whatsapp_key', ''),
		  ),
		));

		$response = curl_exec($curl);
		$err = curl_error($curl);
		$http = (int) curl_getinfo($curl, CURLINFO_HTTP_CODE);
		curl_close($curl);

		$ret = json_decode((string) $response);
		if ($err === '' && is_object($ret) && !empty($ret->id))
			$id = $ret->id;
		else
		{
			$error = 'the receipt PDF could not be uploaded to WhatsApp: ' . donation_whatsapp_error_text($http, $response, $err);
			watchdog('upload_whatsapp_pdf', 'Upload of the receipt of donation %d failed: %why', array('%d' => $donation_id, '%why' => $error), WATCHDOG_ERROR);
		}
	} catch (\Throwable $e) {
		$error = 'the receipt PDF could not be uploaded to WhatsApp: ' . $e->getMessage();
		watchdog("upload_whatsapp_pdf", "Error uploading $donation_id: ".$e->getMessage(), array(), WATCHDOG_ERROR);
	}
	@unlink($data['data']);               // the temporary copy of the receipt
	return $id;
}

/**
 * A short, staff-readable reason from a failed WhatsApp (360dialog) call. Handles the answers seen in the logs:
 * {"error":"This number is blocked ..."}, {"error":{"message":"(#100) Invalid parameter","error_data":{"details":...}}},
 * {"meta":{"developer_message":"Not Found","http_code":404}} and {"errors":[{"title":...,"details":...}]}.
 */
function donation_whatsapp_error_text($http_code, $response, $curl_error = '')
{
	if ((string) $curl_error !== '')
		return 'could not reach the WhatsApp service (' . $curl_error . ')';
	$j = json_decode((string) $response);
	$text = '';
	if (is_object($j))
	{
		if (isset($j->error) && is_string($j->error))
			$text = $j->error;
		elseif (isset($j->error->message))
		{
			$text = preg_replace('/^\(#\d+\)\s*/', '', (string) $j->error->message);
			if (isset($j->error->error_data->details))
			{
				$words = function ($s) { $w = preg_split('/\W+/', strtolower($s), -1, PREG_SPLIT_NO_EMPTY); sort($w); return $w; };
				if ($words((string) $j->error->error_data->details) != $words($text))
					$text .= ' (' . $j->error->error_data->details . ')';
			}
		}
		elseif (isset($j->errors[0]))
			$text = trim((isset($j->errors[0]->title) ? $j->errors[0]->title : '') . (isset($j->errors[0]->details) ? ': ' . $j->errors[0]->details : ''), ': ');
		elseif (isset($j->meta->developer_message))
			$text = $j->meta->developer_message;
	}
	$text = trim(strip_tags((string) $text));
	if ($text === '')
		$text = 'unexpected answer from the WhatsApp service';
	if ($http_code && $http_code >= 400 && strpos($text, (string) $http_code) === FALSE)
		$text .= ' (HTTP ' . $http_code . ')';
	return $text;
}

/**
 * Send the donation's receipt on WhatsApp. Returns array('success', 'msg' = message id or the reason it failed, 'to').
 * Used after saving a donation and by the "Send WhatsApp" link on the report.
 */
function donation_whatsapp_send_receipt($donation_id, $receipt_num = NULL)
{
	$ret = array('success' => False, 'msg' => '', 'to' => '');
	$row = donation_effective_donor($donation_id);
	if (!$row)
	{
		$ret['msg'] = 'the donor details of this donation could not be found';
		return $ret;
	}
	$ret['to'] = trim((string) $row['d_contact']);
	$wa_id = $ret['to'] !== '' ? whatsapp_360_get_waid($ret['to']) : '';
	if (!$wa_id)
	{
		$ret['msg'] = 'there is no mobile number for this donor';
		return $ret;
	}
	$why = '';
	$media = upload_whatsapp_pdf($donation_id, $why);
	if (!$media)
	{
		$ret['msg'] = $why !== '' ? $why : 'the receipt PDF could not be prepared';
		return $ret;
	}
	$params_body = array($row['d_name'], $row['d_currency'].' '.$row['d_amount'], date('jS F, Y', strtotime($row['d_date'])));
	$response = send_whatsapp_360($wa_id, 'dana', array($media), $params_body, $receipt_num !== NULL ? $receipt_num : $row['d_receipt_f'], 'template', $why);
	if ($response)
	{
		$ret['success'] = True;
		$ret['msg'] = $response;
	}
	else
		$ret['msg'] = $why !== '' ? $why : 'WhatsApp did not accept the message';
	return $ret;
}


function upload_whatsapp_pdf_generic($file)
{
    $out = array("success" => true, "ret" => null);

    if (!file_exists($file))
    {
        $out["success"] = false;
        return $out;
    }

    // $data = file_get_contents($file);
    try
    {
        $curl = curl_init();

        curl_setopt_array($curl, array(
          CURLOPT_URL => variable_get('whatsapp_url', '').'/media',
          CURLOPT_RETURNTRANSFER => true,
          CURLOPT_ENCODING => '',
          CURLOPT_MAXREDIRS => 10,
          CURLOPT_TIMEOUT => 0,
          CURLOPT_FOLLOWLOCATION => true,
          CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
          CURLOPT_CUSTOMREQUEST => 'POST',
          CURLOPT_POSTFIELDS => array('messaging_product'=>'whatsapp','file'=> new CURLFILE($file, "application/pdf")),
          CURLOPT_HTTPHEADER => array(
            'D360-Api-Key: '.variable_get('whatsapp_key', ''),
          ),
        ));

        $response = curl_exec($curl);
        curl_close($curl);

        $ret = json_decode($response);

        $file_id = $ret->id;

        if($file_id)
        {
            $out["file_id"] = $file_id;
            return $out;
        }
        else
        {
            $out["success"] = false;
            return $out;
        }


    }
    catch (\Throwable $e)
    {
        watchdog("upload_whatsapp_pdf_generic", "Error uploading $filename: ".$e->getMessage());
        $out["success"] = false;
        return $out;
    }
}


function send_email( $donation_id )
{
	$ret = send_donor_email($donation_id);
	drupal_json_output($ret);
	exit(0);
}

function send_whatsapp( $donation_id )
{
	// R5b (donor versioning): number and name of the donation's financial year (U2).
	$ret = array('success' => False, 'msg' => 'Unable to send', 'to' => '');
	if (!donation_versioning_ready('read'))
	{
		$ret['msg'] = 'Donor versioning is not completely installed on this site';
		drupal_json_output($ret);
		exit(0);
	}
	$ret = donation_whatsapp_send_receipt($donation_id);
	drupal_json_output($ret);
	exit(0);
}

/**
 * Send a WhatsApp template message. Returns the message id, or '' when it failed; then $error gets a short,
 * staff-readable reason (and the failure is logged).
 */
function send_whatsapp_360( $to, $template, $params_header, $params_body, $receipt_num, $type = "template", &$error = NULL)
{
    $error = '';
    $p_header_arr = array();
    $namespace = variable_get('whatsapp_namespace', '');
    $wa_url = variable_get('whatsapp_url', '');
    $wa_api_key = variable_get('whatsapp_key', '');
    $p_arr = array();
    if ($params_body)
    {
        foreach($params_body as $key => $val)
        {
            $p_arr[] = array("type" => "text", "text" => $val );
        }
    }
    if ($params_header)
    {
        foreach($params_header as $key => $val)
        {
            $p_header_arr[] = array("type" => "document", "document" => array( "id" => $val, "filename" => $receipt_num.".pdf" ) );
        }
    }

    if ($type == 'template')
        $payload = json_encode(array("messaging_product"=> "whatsapp", "recipient_type" => "individual", 'to' => $to, "type" => 'template', 'template' => array('namespace' => $namespace, "language" => array("policy" => "deterministic", "code" => "en"), "name" => $template, "components" => array(array("type" => "body", "parameters" => $p_arr), array("type" => "header", "parameters" => $p_header_arr) ))));
    else
        $payload = json_encode(array("messaging_product"=> "whatsapp", "recipient_type" => "individual", 'to' => $to, "type" => 'text', 'text' => array("body" => $params) ));

    $headers = [
        "Content-Type: application/json",
        "D360-Api-Key: $wa_api_key",
    ];

    $curl = curl_init();

    curl_setopt_array($curl, [
        CURLOPT_URL => $wa_url.'/messages',
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_CUSTOMREQUEST => "POST",
        CURLOPT_POSTFIELDS => $payload,
        CURLOPT_HTTPHEADER => $headers,
        CURLOPT_CONNECTTIMEOUT => 10,
        CURLOPT_TIMEOUT => 30,
    ]);

    $response = curl_exec($curl);
    //var_dump($response);
    $err = curl_error($curl);
    $http = (int) curl_getinfo($curl, CURLINFO_HTTP_CODE);

    curl_close($curl);
    $ret = '';

    if ($err) {
        $error = donation_whatsapp_error_text($http, $response, $err);
        watchdog('Donation', 'Unable to send Whatsapp: '.$to.' template: '.$template.': '.$err.': '.$response, array(), WATCHDOG_ERROR);
    } else {
	    watchdog('Whatsapp Response', $response);
        $json = json_decode((string) $response);
        if (is_object($json) && isset($json->messages[0]->id))
            $ret = $json->messages[0]->id;
        else {
            $error = donation_whatsapp_error_text($http, $response);
            watchdog('Donation', 'Unable to send Whatsapp: %to template: %t: %why', array('%to' => $to, '%t' => $template, '%why' => $error), WATCHDOG_ERROR);
        }
    }
    return $ret;
}


function whatsapp_360_get_waid( $to )
{
    return $to;
    $namespace = variable_get('whatsapp_namespace', '');
    $wa_url = variable_get('whatsapp_url', '');
    $wa_api_key = variable_get('whatsapp_key', '');
    $p_arr = array();

    $payload = json_encode(array("blocking" => "wait", "contacts" => array($to),  "force_check" => True));

    $headers = [
        "Content-Type: application/json",
        "D360-Api-Key: $wa_api_key",
    ];

    $curl = curl_init();

    curl_setopt_array($curl, [
        CURLOPT_URL => $wa_url.'/contacts',
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_CUSTOMREQUEST => "POST",
        CURLOPT_POSTFIELDS => $payload,
        CURLOPT_HTTPHEADER => $headers,
    ]);

    $response = curl_exec($curl);
    $err = curl_error($curl);

    curl_close($curl);
    $ret = '';
    watchdog('Donation', 'waid'.$response);
    if ($err) {
        watchdog('Donation', 'Unable to get Whatsapp ID: '.$to.': '.$err.': '.$response, array(), WATCHDOG_ERROR);
    } else {
        $ret = json_decode($response);
        if (($ret->contacts[0]->status == 'valid') && isset($ret->contacts[0]->wa_id))
            $ret = $ret->contacts[0]->wa_id;
        else
            $ret = '';
    }
    return $ret;
}

function view_log_form( $form, &$form_state, $donation_id )
{
	//drupal_set_message("Got Don id  $donation_id");
	$q = "select d_receipt_f from dh_donation where d_id=$donation_id";
	$receipt_num = db_query($q)->fetchField();
	drupal_set_title('Log Details for Receipt '.$receipt_num);
	// "Receipt archived" rows (P1 archive copies) stay in dh_log for admins but are not shown to centres
	$q = "select l_msg, l_tstamp, u.name from dh_log l left join users u on (l.l_user=u.uid) where l.l_identifier = $donation_id and l_module='dh_donation' and not (l.l_event <=> 'Receipt archived')";
	$hand = db_query($q);
	$rows = array();
	while( $row = $hand->fetchAssoc())
	{
		$row['l_msg'] = nl2br(check_plain(trim($row['l_msg'])));       // stored XSS: log text can carry donor and staff input
		$row['name'] = check_plain($row['name']);
		$rows[] = $row;
	}
	$headers = array('Log', 'DateTime', 'User');
	$out = theme('table', array( 'header' => $headers, 'rows' => $rows ));
	$form['a'] = array('#type' => 'markup', '#markup' => $out );
	return $form;
}


function update_tags()
{
  $out = array();
  $out['status'] = 'OK';
  $out['msg'] ="";

  $action = arg(1);

  $selections = utf8_encode($_REQUEST['s']);
  $selections = json_decode($selections);

  // watchdog("lama", print_r($selections, true));
  // watchdog("lama", $action);

  $tags = array();
  $tag_ids = array();
  foreach ($selections as $s)
  {
    $tags[] = $s->{"text"};
    $tag_ids[] = $s->{"id"};
  }

  if(count($tag_ids) == 0)
  {
    $out['status'] = 'Failed';
    $out['msg'] ="None of tags selected";
    drupal_json_output($out);
    exit;
  }

  if($action == "create")
  {
    $q = "insert ignore into dh_tag (t_tag) values ";
    foreach($tags as $tag)
    {
      $q .= " ('$tag'), ";
    }

    $q = rtrim($q, ", ");
    db_query($q);

    $out['msg'] ="Tags ".implode(', ', $tags)." created.";
  }

  if($action == "delete")
  {
    $count = db_query("select count(*) from dh_donation_tag where dt_tag in (:tag_ids)", array(':tag_ids' => $tag_ids))->fetchField();
    if($count > 0)
    {
      $out['status'] = 'Failed';
      $out['msg'] ="At least one of selected tag are tagged with donations. Please remove them in order to delete.";
    }
    else
    {
      db_query("delete from dh_tag where t_id in (:tag_ids)", array(':tag_ids' => $tag_ids));
      $out['msg'] = "Tags ".implode(', ', $tags)." deleted.";
    }

  }

  drupal_json_output($out);
  exit;
}


function view_tags($don_id)
{
  $out = array();
  $out['status'] = 'OK';
  $out['msg'] ="";

  $q = "select t_tag from dh_donation_tag left join dh_tag on dh_donation_tag.dt_tag=dh_tag.t_id where dt_donation=:don_id";
  $tags = db_query($q, array(':don_id' => $don_id))->fetchCol();

  if($tags)
  {
    //foreach
    $out['msg'] = implode(', ', $tags);
  }
  else
    $out['status'] = 'Failed';

  drupal_json_output($out);
  exit;
}


function update_don_tags()
{
  $out = array();
  $out['status'] = 'OK';
  $out['msg'] ="";

  $action = arg(1);

  $selections = json_decode(utf8_encode($_REQUEST['s']));
  $donations = (array)json_decode(utf8_encode($_REQUEST['d']));

  $tags = array();
  foreach ($selections as $s)
  {
    $tags[$s->{"id"}] = $s->{"text"};
  }

  watchdog("lama", print_r($tags, true));
  watchdog("lama", print_r($donations, true));

  if(count($tags) == 0 || count($donations) == 0)
  {
    $out['status'] = 'Failed';
    $out['msg'] ="None of tags or donations selected.";
    drupal_json_output($out);
    exit;
  }

  if($action == "assign")
  {
    $q = "insert ignore into dh_donation_tag (dt_donation, dt_tag) values ";
    foreach($donations as $donation_id => $donation_receipt_num)
    {
      foreach($tags as $tag_id => $tag_name)
      {
        $q .= " ('$donation_id', '$tag_id'), ";
      }
    }


    $q = rtrim($q, ", ");
    db_query($q);

    $out['msg'] ="Tags ".implode(', ', $tags)." assigned to Donations ".implode(', ', $donations);
  }

  if($action == "unassign")
  {
      db_query("delete from dh_donation_tag where dt_donation in (:donations) and dt_tag in (:tags)", array(':donations' => array_keys($donations), ':tags' => array_keys($tags) ));
      $out['msg'] ="Tags ".implode(', ', $tags)." unassigned from Donations ".implode(', ', $donations);
  }

  drupal_json_output($out);
  exit;
}

function get_mailgun_domain($from)
{
    $mailgun_dhamma_domain = "";
    $mailgun_vridhamma_domain = "";
    $mailgun_domains = array_map('trim', explode(',', variable_get('mailgun_primary_domain', '')));

    $mailgun_domain = $mailgun_domains[0];
    $from_top_domain = implode('.', array_slice(explode('.', imap_rfc822_parse_adrlist($from, "")[0]->host), -2, 2));

    foreach($mailgun_domains as $d)
    {
        $mailgun_top_domain = implode('.', array_slice(explode('.', $d), -2, 2));
        if(strtolower($from_top_domain) == strtolower($mailgun_top_domain))
          $mailgun_domain = $d;
    }

    return $mailgun_domain;
}
