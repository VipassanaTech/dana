    $val = variable_get('donation_email', '');
    $form['donation_email'] = array(
         '#type' => 'textfield',
         '#required' => false,
         '#default_value' => $val,
         '#title' => t('From Email'),
         '#description' => t('Email which will be used when sending email'),
   );

    $val = variable_get('donation_email_bcc', '');
    $form['donation_email_bcc'] = array(
         '#type' => 'textfield',
         '#required' => false,
         '#default_value' => $val,
         '#title' => t('Email to send a bcc copy of the receipt'),
         '#description' => t('Email to send a bcc copy of the receipt. For eg centre email id for reference'),
   );
   
 
   return system_settings_form($form);
}


/** HEAD donation.module:571-589. */
function donation_manage()
{
	// Until the menu is rebuilt (F5), donation/reprint/<id> falls back to this callback.
	if (arg(1) == 'reprint')
		return (donation_reprint_access() && adonation_id_load(arg(2))) ? drupal_get_form('donation_reprint_form', arg(2)) : MENU_ACCESS_DENIED;
	$row = array();
	if (arg(2) > 0)
	{
		if (!donation_versioning_require(NULL, 'read'))
			return '';
		$row = db_query('SELECT d.* FROM dh_donation d WHERE d.d_id = :id', array(':id' => (int) arg(2)))->fetchAssoc();
		if ($row && (int) $row['d_donor'] > 0)
			$row = donation_prefill_donor($row, (int) $row['d_donor'], (int) $row['d_fy']);
	}
	return drupal_get_form('donation_main_form', $row ? $row : array());
}


// Cancel a donation. Only a POST from the report's cancel dialog (token + cancelled
// reason) cancels; the reason is prepended to the comment (see cancel-stamp.inc).
function donation_cancel( $donation_id )
{
	global $user;
	if ( ($_SERVER['REQUEST_METHOD'] != 'POST') || !isset($_POST['token']) || !drupal_valid_token($_POST['token'], 'donation-cancel-'.$donation_id) )
	{
		drupal_set_message(t('Please cancel the transaction from the Donation Report.'), 'error');
		drupal_goto("donation-report");
	}
	$reason = donation_cancel_clean_reason(isset($_POST['cancel_reason']) ? $_POST['cancel_reason'] : '');
	if ( !preg_match('/[\p{L}\p{N}]/u', $reason) || (drupal_strlen($reason) > DONATION_CANCEL_REASON_MAX) )
	{
		drupal_set_message(t('Transaction not cancelled: the cancelled reason is required (maximum @max characters).', array('@max' => DONATION_CANCEL_REASON_MAX)), 'error');
		drupal_goto("donation-report");
	}
	$old_comment = db_query("select d_comment from dh_donation where d_id = :id", array(':id' => $donation_id))->fetchField();
	db_update('dh_donation')->fields(array('d_deleted' => 1, 'd_deleted_date' => date('Y-m-d H:i:s'), 'd_deleted_by' => $user->uid,
		'd_comment' => donation_cancel_comment($reason, $old_comment)))->condition('d_id', $donation_id)->condition('d_deleted', '0')->execute();
	drupal_set_message("Transaction Cancelled successfully");
	drupal_goto("donation-report");
}

function donation_report()
{
	global $user;
	// Sites whose menu cache still routes donation/delete here (until it is rebuilt).
	if (arg(1) == 'delete')
		return donation_cancel(arg(2));

	$form_state = array(); 
 	$form_state['storage']['r_from'] = date('Y-m-d');
	$form_state['storage']['r_to'] = date('Y-m-d');
	$form_state['storage']['r_foreign'] = 'all';
	$form_state['storage']['r_category'] = 'all';
  $form_state['storage']['r_id_type'] = 'all';
	$form_state['storage']['r_type'] = array();
  $form_state['storage']['r_tags'] = array();
	$form_state['storage']['r_course'] = '';
	$form_state['storage']['r_name'] = '';
	$form_state['storage']['r_receipt'] = '';
  $form_state['storage']['min_amount'] = '';
  $form_state['storage']['max_amount'] = '';
  $form_state['storage']['photo_id'] = '';
  $form_state['storage']['synced'] = 0;
  $form_state['storage']['not_synced'] = 0;
  $form_state['storage']['deleted'] = 0;
  $form_state['storage']['with_logs'] = 0;
	$form_state['values'] = $form_state['storage'];
	$out = drupal_build_form('donation_report_form',$form_state);

//	drupal_form_submit('donation_report_form', );
//	$out = drupal_get_form('donation_report_form');
	return $out;	
}


function _get_country( $name )
{
	$q = 'select c_name from dh_country where c_name like \''.$name.'%\' order by c_name';
	$return = db_query($q);
	$matches = array();
  	foreach ($return as $row) {
    	$matches[$row->c_name] = $row->c_name;
  	}
  	drupal_json_output($matches);  	
  	exit(0);
}

function _get_state( $name )
{
	$country = $_REQUEST['country'];
	$country_code = db_query("select c_code from dh_country WHERE c_name='$country'")->fetchField();
	$q = 'select s_name from dh_state where s_country=\''.$country_code.'\' and  s_name like \''.$name.'%\' order by s_name';
	$return = db_query($q);
	$matches = array();
  	foreach ($return as $row) {
    	$matches[$row->s_name] = $row->s_name;
  	}
  	drupal_json_output($matches);  	
  	exit(0);
}

function _get_city( $name )
{
	$country = $_REQUEST['country'];
	$country_code = db_query("select c_code from dh_country WHERE c_name='$country'")->fetchField();

	$state = $_REQUEST['state'];
	$state_code = db_query("select s_code from dh_state WHERE s_name='$state'")->fetchField();

	$q = 'select c_city from dh_city where c_country=\''.$country_code.'\' and c_state=\''.$state_code.'\' and  c_city like \''.$name.'%\' order by c_city';
	$return = db_query($q);
	$matches = array();
  	foreach ($return as $row) {
    	$matches[$row->c_city] = $row->c_city;
  	}
  	drupal_json_output($matches);  
  	exit(0);	
}


function _get_location_from_pincode()
{
	$code = $_REQUEST['code'];
	$matches = array();
	$q = "select co.c_name,s.s_name,ci.c_city from dh_pincode p left join dh_city ci on p.p_city=ci.c_id left join 
		dh_state s on (ci.c_state=s.s_code and ci.c_country=s.s_country) left join dh_country co on ci.c_country=co.c_code where 
		p_code='$code' limit 0,1";
	$return = db_query($q);

  	foreach ($return as $row) {
    	$matches[] = array( 'country' => $row->c_name, 'state' => $row->s_name, 'city' => $row->c_city );
  	}

  	drupal_json_output($matches);  	
  	exit(0);
}

function _get_donor_detail()
{
	// R2 (donor versioning): the donor's details as used by financial year `fy` (optional; 0 = current year),
	// returned RAW (no check_plain: the donation form compares raw values, N1), plus the current details,
	// per-year donation counts and the signed baseline the form posts back (M4).
	$did = isset($_REQUEST['did']) ? (int) $_REQUEST['did'] : 0;
	$fy = isset($_REQUEST['fy']) ? (int) $_REQUEST['fy'] : 0;
	$matches = array();
	$deleted = $did > 0 ? db_query('SELECT d_deleted FROM dh_donor WHERE d_id = :d', array(':d' => $did))->fetchField() : FALSE;
	if (donation_versioning_ready('read') && $deleted !== FALSE && (string) $deleted === '0')
	{
		$qfy = $fy > 0 ? $fy : donation_cur_fy();
		$eff = donor_effective_dv($did, $qfy);
		$live = donor_live_dv($did);
		if ($eff && $live)
		{
			$show = donor_display_from_row($eff['dv']);
			$lshow = donor_display_from_row($live);
			$fyc = array();
			$fyca = array();
			$count = 0;
			$res = db_query("SELECT d_fy, COUNT(*) AS n, SUM(d_deleted = '0') AS n_active FROM dh_donation WHERE d_donor = :d GROUP BY d_fy", array(':d' => $did));
			foreach ($res as $c)
			{
				$fyc[$c->d_fy] = (int) $c->n;
				$fyca[$c->d_fy] = (int) $c->n_active;
				$count += (int) $c->n;
			}
			$since = '';
			$source = '';
			if ($eff['own'])
			{
				$ymd = explode('-', substr((string) $eff['since'], 0, 10));
				$since = count($ymd) == 3 ? $ymd[2] . '/' . $ymd[1] . '/' . $ymd[0] : '';
				$source = (string) db_query('SELECT dv_source FROM dh_donor_version WHERE dv_id = :v', array(':v' => $eff['vid']))->fetchField();
			}
			$keys = array('name' => 'd_name', 'address' => 'd_address', 'country' => 'd_country', 'state' => 'd_state', 'city' => 'd_city',
				'contact' => 'd_contact', 'idtype' => 'd_id_type', 'idno' => 'd_id_no', 'pincode' => 'd_pincode', 'email' => 'd_email', 'gender' => 'd_gender');
			$m = array('did' => $did, 'count' => $count, 'fy' => $qfy, 'frozen' => $eff['own'] ? 1 : 0, 'fy_since' => $since, 'fy_source' => $source,
				'fycounts' => $fyc, 'fycounts_active' => $fyca, 'live' => array());
			foreach ($keys as $k => $col)
			{
				$m[$k] = $show[$col];
				$m['live'][$k] = $lshow[$col];
			}
			$matches[] = $m + donation_donor_detail_baseline($did, $fy);
		}
	}
	drupal_json_output($matches);
	exit(0);
}

function _save_positions()
{
	$data = $_REQUEST['data'];
	if ($data <> '')
		$arr = json_decode($data);
	else
		$arr = array();
	
	file_put_contents(drupal_realpath('public://')."/config.data", serialize($arr));
	//echo "All good";
	//watchdog('donation', print_r($arr,true));
}


function _get_positions()
{
	$pos = array();
	$data = unserialize(file_get_contents(drupal_realpath('public://')."/config.data"));
	foreach ($data as $obj) 
	{
		if( @$obj->field <> '')
		{
			$f = str_replace(array("edit-", "-") ,array("", "_"), $obj->field );
			$pos[$f]['left'] = $obj->left;
			$pos[$f]['top'] = $obj->top;			
		}
	}
	//print_r($pos);
	return $pos;
}


function _get_donors( $name )
{
	$course = '';
	if ( isset($_REQUEST['course']))
		$course = $_REQUEST['course'];
	$matches = array();
  	$query = db_select('dh_donor', 'd');
  	$query->condition('d.d_deleted', 0);
        $course_type = '';
        if ( $course > 0)
           $course_type = db_query("select c_type from dh_course where c_id='$course'")->fetchField();

  	// Select rows that match the string
  	if ( ($course > 0) && ($course_type <> '1 Day Course')  ) //in_array($course_type, array('10-day', '3-day', 'Executives', '2-day'))
  	{
	  	$return = $query
	    	->fields('d', array('d_name', 'd_id'))
	    	->condition('d.d_name', '%' . db_like($name) . '%', 'LIKE')
	    	->condition('d.d_course', $course , '=')
	    	->range(0, 10)
	    	->orderBy('d_name', 'ASC')
	    	->execute();	
  	}
	else if ( $course > 0 )
	{
	  	$return = $query
	    	->fields('d', array('d_name', 'd_id'))
	    	->condition('d.d_name', '%' . db_like($name) . '%', 'LIKE')
	    	->range(0, 10)
	    	->orderBy('d_name', 'ASC')
	    	->execute();  		
	}
	else
	  	$return = $query
	    	->fields('d', array('d_name', 'd_contact', 'd_id'))
	    	->condition('d.d_name', '%' . db_like($name) . '%', 'LIKE')
	    	->range(0, 10)
	    	->orderBy('d_name', 'ASC')
	    	->execute();  		
  
  	$single = array();
  	// add matches to $matches  
  	foreach ($return as $row) 
  	{
	    	//$matches[] = array('label' => check_plain($row->d_name), 'value' => $row->d_id);
	    	if (property_exists($row, 'd_contact'))
	    		$matches[] = array('label' => $row->d_name.' - '.$row->d_contact, 'value' => $row->d_id);
	    	else	
	    		$matches[] = array('label' => $row->d_name, 'value' => $row->d_id);;

	    	$single[$row->d_name] = $row->d_name;
	    	//$single[] = array('label' => $row->d_name, 'value' => $row->d_id);;
  	}
  	
  	// return for JS
  	if ( !isset($_REQUEST['course']))
  		drupal_json_output($single);
  	else
  		drupal_json_output($matches);
  	exit(0);
}


function get_default( $field, $data, $val )
{
	if (isset($data['d_id']) && ($field =='submit'))
		return 'Update Receipt';
	if (!isset($data[$field]))
		return $val;
	return $data[$field];
}

function donation_main_form($form, &$form_state, $edit_data = array())
{	
	// Rebuild after an FY change while the form was open (L25, M5): reload the donor part for the posted date's FY.
	if (!empty($form_state['storage']['donor_reload']))
	{
		$r = $form_state['storage']['donor_reload'];
		unset($form_state['storage']['donor_reload']);
		if ($r['donor'] > 0)
			$edit_data = donation_prefill_donor($edit_data, $r['donor'], donation_fy_from_date($r['date']));
	}

	//$attribs = array('#theme' => 'form_panel_table', '#form_panel_weights_decimal' => TRUE);
	//$position = _get_positions();
	$attribs = array('class' => array('grid-stack') );
	$attribs = array();

	// Edit flow = an existing donation is loaded (URL /donation/edit/<id>, so
	// $edit_data has d_id). The shared-donor warning applies only when editing.
	$is_edit = !empty($edit_data['d_id']) ? 1 : 0;

	$query = "select c_code, c_name from dh_currency order by c_code";
	$result = db_query( $query );
	$currencies = array();
	foreach($result as $row)
		$currencies[ $row->c_code ] = $row->c_code.' - '.$row->c_name;

	$txns = explode("\n", variable_get('txn_types', ""));
	foreach ($txns as $v) 
	{
		$t = explode("=", $v);
		if (count($t) >= 2)
			$txn_types[trim($t[0])] = trim($t[1]);
	}

	$id_types = donor_id_type_options(isset($edit_data['d_id_type']) ? $edit_data['d_id_type'] : NULL);

/*    $query = "select tm_display, tm_key from dh_tally_mapping where tm_foreign=0 and tm_enabled=1";
    $result = db_query( $query );
    $txn_types = array();
    foreach($result as $row)
            $txn_types[ $row->tm_key ] = $row->tm_display;
*/


	$query = "select c_id, CONCAT(DATE_FORMAT(c_start, '%Y'), ' / ', c_type, ' / ', DATE_FORMAT(c_start, '%D %b'), ' to ', DATE_FORMAT(c_end, '%D %b')) as 'a' 
		from dh_course where (c_start > SUBDATE(CURDATE(), INTERVAL 45 DAY) and c_start <= CURDATE()) OR (c_end > SUBDATE(CURDATE(), INTERVAL 2 DAY) and c_start < CURDATE() ) order by c_start";
	$result = db_query( $query );
	$courses = array('0' => t('Non Course') );
	foreach($result as $row)
		$courses[ $row->c_id ] = $row->a;

	if ( (date("w") == 0) && (date('H') > 14 ) )
		$default_course = db_query("select c_id from dh_course WHERE c_type ='1-day' and  CURDATE() = c_end")->fetchField();
	else
		$default_course = db_query("select c_id from dh_course WHERE SUBDATE(c_end, INTERVAL 1 DAY) = CURDATE() OR CURDATE() = c_end")->fetchField(); 

	$form['#attributes'] = $attribs;
	$form['dana_help'] = array('#markup' => $is_edit ? dana_help_link('change-donation', 'edit') : dana_help_link('donation'), '#weight' => -100);

	$form['d_course'] = array('#type' => 'select', '#title' => 'Select Course', 
		'#options' => $courses, '#default_value' => get_default('d_course', $edit_data, $default_course), '#weight' => 1.1, '#attributes' => array('class' => array('col-sm-6')) );

/*	$form['d_category'] = array('#type' => 'radios', '#title' => 'Category', '#required' => true, 
		'#options' => array('general' => 'General', 'pagoda' => 'Pagoda', 'corpus' => 'Corpus' ), 
		'#default_value' => get_default('d_category',$edit_data, 'general'), '#weight' => 1.2, '#attributes' => array('class' => array('col-sm-6')) );
*/
        $cost_categories = array();
        foreach (explode("\n", variable_get("cost_category", '')) as $v )
           $cost_categories[ trim($v) ] = trim($v);

        $form['d_category'] = array('#type' => 'select', '#title' => 'Category', '#required' => true,
                '#options' => $cost_categories,
                '#default_value' => get_default('d_category',$edit_data, ''), '#weight' => 1.2, '#attributes' => array('class' => array('col-sm-6')) );

	$form['d_gender'] = array('#type' => 'radios', '#title' => 'Gender', '#required' => true, 
		'#options' => array('male' => 'Male', 'female' => 'Female',
            // 'trans' => 'TransGender',
            'ms' => 'Organization' ),
		'#default_value' => get_default('d_gender', $edit_data, 'male'), '#weight' => 1.3, '#attributes' => array('class' => array('col-sm-4')) );

	// L28: which details the donation's financial year uses (filled by DanaDonor.badge() from the signed baseline)
	$form['donor_fy_badge'] = array('#markup' => '<div id="donor-fy-badge" class="messages status donor-fy-badge" style="display:none"></div>', '#weight' => 3.05);

	$form['d_name'] = array('#type' => 'textfield', '#size' => 50, '#title' => 'Donor Name', 
		'#attached' => array(
      		'library' => array(
        		array('system', 'ui.autocomplete'),
      	)),
		'#required' => true, '#weight' => 3.1, '#default_value' => get_default('d_name',$edit_data, '') );

	$form['d_id_type'] = array('#type' => 'select', '#title' => 'ID Type', '#options' => $id_types, '#validated' => TRUE,
		'#description' => 'Type of ID','#weight' => 3.2, '#required' => 1, '#default_value' => get_default('d_id_type', $edit_data, '1') );

	$form['d_id_no'] = array('#type' => 'textfield', '#size' => 20, '#title' => 'ID No', 
		'#description' => 'Passport No for Foreign Nationals','#weight' => 3.3, '#default_value' => get_default('d_id_no', $edit_data, '') );


	$form['d_contact'] = array('#type' => 'textfield', '#size' => 30, '#title' => 'Contact No', 
		'#required' => true,  '#weight' => 4.1, '#default_value' => get_default('d_contact', $edit_data ,'') );
