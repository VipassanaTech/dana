function adonation_id_load( $id )
{
	global $user;
	$res = false;
	$query = db_select('dh_donation', 'd')->fields('d', array('d_id'))->condition('d_id', $id)->condition('d_deleted', '0');
	if (user_access('access own donation') && (!user_access('administer donation')) )
	{
		$query->condition('d_createdBy', $user->uid);	
	}
	$result = $query->execute();
	if ( $result->rowCount() <= 0 )
		return $res;
	return $id;
}

// Like adonation_id_load but also allows cancelled donations, so their receipt
// (stamped CANCELLED) and log can still be viewed.
function receipt_donation_id_load( $id )
{
	global $user;
	$query = db_select('dh_donation', 'd')->fields('d', array('d_id'))->condition('d_id', $id);
	if (user_access('access own donation') && (!user_access('administer donation')) )
	{
		$query->condition('d_createdBy', $user->uid);
	}
	if ( $query->execute()->rowCount() <= 0 )
		return false;
	return $id;
}

function tag_donation_id_load( $id )
{
  global $user;
  $res = false;
  $query = db_select('dh_donation', 'd')->fields('d', array('d_id'))->condition('d_id', $id);
  if (user_access('access own donation') && (!user_access('administer donation')) )
  {
    $query->condition('d_createdBy', $user->uid);
  }
  $result = $query->execute();
  if ( $result->rowCount() <= 0 )
    return $res;
  return $id;
}


function donation_id_load( $id )
{
	global $user;
	$res = false;
	$query = db_select('dh_donation', 'd')->fields('d', array('d_id'))->condition('d_id', $id)->condition('d_deleted', '0')->condition('d_type', 'razorpay', '<>');

  if ( (!user_access('edit delete after tally sync')) )
  {
    $query->condition('d_synced', '0');
  }

	if (user_access('access own donation') && (!user_access('administer donation')) )
	{
		$query->condition('d_createdBy', $user->uid);	
	}
	$result = $query->execute();
	if ( $result->rowCount() <= 0 )
		return $res;
	return $id;
}

function donation_edit_access()
{
	if (user_access('administer donation') or user_access('edit own donation'))
		return TRUE;
	else
		return FALSE;
}


function donation_delete_access()
{
	if (user_access('administer donation') or user_access('delete transaction'))
		return TRUE;
	else
		return FALSE;
}

function donation_file_download($uri) 
{
	// Get the file record based on the URI. If not in the database just return.
	//drupal_set_message($uri);
	$file = drupal_realpath($uri);
 	if ( !file_exists($file) )
 	{
 		watchdog('File', 'File not Found - '.$uri);
 		return;
 	}
 	$ext = strtolower(pathinfo($file, PATHINFO_EXTENSION));
 	
	global $user;

	if ( $ext == 'pdf' )
	{
		if (user_access('access donation'))
		{
			$name = basename($file);
			$header = array('Content-Type' => 'application/pdf', 'Content-Length' => filesize($file), 'Content-disposition' => 'inline; filename="'.$name.'"',
				'Cache-Control' => 'private');
			return $header;
		}		
	}
}



function donation_admin_form($form, &$form_state)
{
  $form['dana_help'] = array('#markup' => dana_help_link('settings'), '#weight' => -100);

  $form["set_receipt_paper"] = array('#type' => 'checkbox', '#title' => 'Set Paper as Default', '#default_value' => variable_get("set_receipt_paper", 0));
  $form["set_receipt_email"] = array('#type' => 'checkbox', '#title' => 'Set Email as Default', '#default_value' => variable_get("set_receipt_email", 0));
  $form["set_receipt_whatsapp"] = array('#type' => 'checkbox', '#title' => 'Set Whatsapp as Default', '#default_value' => variable_get("set_receipt_whatsapp", 0));


	$query = "select c_code, c_name from dh_currency order by c_code";
	$result = db_query( $query );
	$currencies = array();
	foreach($result as $row)
		$currencies[ $row->c_code ] = $row->c_code.' - '.$row->c_name;

    $val = variable_get('currency', 'INR');
    $form['currency'] = array(
         '#type' => 'select',
         '#options' => $currencies,
         '#required' => TRUE,
         '#default_value' => $val,
         '#title' => t('Default Currency'),
         '#description' => t('Default Currency for dana'),
   );

    $val = variable_get('receipt_prefix', '');
    $form['receipt_prefix'] = array(
         '#type' => 'textfield',
         '#size' => 10,
         '#required' => false,
         '#default_value' => $val,
         '#title' => t('Receipt Prefix'),
         '#description' => t('Prefix to the generated receipt No. For eg: ER- for E-Receipt'),
   );


    $val = variable_get('cost_category', 'Course - General');
