			t += "<tr><td>Address</td><td>&nbsp;&nbsp;</td><td><b>"+DanaDonor.esc($("#edit-d-address").val())+"</b></td></tr>";			
			t += "<tr><td>Type of Transaction</td><td>&nbsp;&nbsp;</td><td><b>"+DanaDonor.esc($("input[name=d_type]:checked").next("label:first").text())+"</b></td></tr>";
			t += "<tr><td>Amount</td><td>&nbsp;&nbsp;</td><td><b>"+DanaDonor.esc($("#edit-d-amount").val()+" "+$("#edit-d-currency").val())+"</b></td></tr>";
			t += "<tr><td>Amount Details</td><td>&nbsp;&nbsp;</td><td><b>"+DanaDonor.esc($("#edit-d-ref-no").val()+"/"+$("#edit-d-bank").val()+"/"+$("#edit-d-branch").val()+"/"+$("#edit-d-chq-date").val())+" </b></td></tr>";
			t += "</table>";
			// One confirm dialog (jquery-confirm): summary, reassignment notice, changed donor fields and, for a past FY,
			// the scope choice, which it writes into the hidden donor_scope field before submitting (M5, M6).
			DanaDonor.confirm(currentForm, t);
		}

