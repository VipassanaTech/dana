            $txn_types_totals[] = $row->tm_display;
    }
    */

	drupal_add_css(drupal_get_path('module', 'donation').'/donation.css');

	$form['r_from'] = array('#type' => 'textfield', '#default_value' => date('Y-m-d'), '#title' => t('From Date'),
		'#attached' => array(
      		'library' => array(
        		array('system', 'ui.datepicker'),
