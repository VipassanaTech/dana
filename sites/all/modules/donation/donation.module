	$form['r_foreign'] = array('#type' => 'select', '#title' => t('Type'), 
		'#options' => array('all' => t('Both'), 'local' => t('Local') , 'foreign' => t('Foreign') ), 
		'#default_value' => 'all', '#weight' => 1.4 );

/*	$form['r_category'] = array('#type' => 'select', '#title' => 'Category', 
		'#options' => array('all' => 'All', 'general' => 'General', 'pagoda' => 'Pagoda', 'corpus' => 'Corpus' ), 
		'#default_value' => 'all', '#weight' => 1.4 );
*/
        $cost_categories = array('all' => t('All') );
        foreach (explode("\n", variable_get("cost_category", '')) as $v )
           $cost_categories[ trim($v) ] = trim($v);
        $form['r_category'] = array('#type' => 'select', '#title' => t('Category'),
                '#options' => $cost_categories,
                '#default_value' => 'all', '#weight' => 1.5 );

  $id_types = db_query("select it_code, it_name from dh_id_types")->fetchAllKeyed();
  $id_type = array('all' => t('All') );

  foreach ($id_types as $id_key => $id_value)
    $id_type[$id_key] = $id_value;

  $form['r_id_type'] = array('#type' => 'select', '#title' => t('ID Type'),
        '#options' => $id_type,
        '#default_value' => 'all', '#weight' => 1.51 );

	$form['r_type'] = array('#type' => 'select', '#title' => t('Type of Transaction'),  
		'#options' => $txn_types, /*array('all' => t('All'), 'cash' => t('Cash'), 'cheque' => t('Cheque'), 'bank-transfer' => t('Bank Transfer'), 'card' => t('Credit/Debit Card') ),*/ 
    '#multiple' => true,
    '#size' => 30,
		'#weight' => 1.6);

    $tags = db_query("select t_id, t_tag from dh_tag")->fetchAllKeyed();

    if(user_access("view donation tags"))
    {
      $form['r_tags'] = array('#type' => 'select', '#title' => t('Tags'),
        '#options' => $tags,
        '#multiple' => true,
        '#size' => 30,
        '#weight' => 1.61);
    }
    else
    {
      $form['r_tags'] = array(
        '#type' => 'hidden',
        '#value' => null,
        '#weight' => 1.61);
    }



	$form['r_course'] = array('#type' => 'select', '#title' => t('Course'),  
		'#options' => $courses, 
		'#default_value' => '', '#weight' => 2.1);

	$form['r_receipt'] = array('#type' => 'textfield', '#title' => t('Receipt No'),  
		'#description' => t('Only number without ER-'), '#size' => 15,
		'#default_value' => '', '#weight' => 2.2);

	$form['r_name'] = array('#type' => 'textfield', '#title' => t('Donor Name'),  
		'#size' => 25,
		'#attached' => array(
      		'library' => array(
        		array('system', 'ui.autocomplete'),
      	)),
		'#default_value' => '', '#weight' => 2.3);



	$form['r_user'] = array('#type' => 'select', '#title' => t('Created By'),  
		'#description' => '',
		'#options' => $created_by,
		'#default_value' => '', '#weight' => 2.4);

  $form['min_amount'] = array(
    '#type' => 'textfield',
    '#attributes' => array(
        ' type' => 'number', // insert space before attribute name :)
    ),
    '#title' => t('Min Amount'),
    '#maxlength' => 10,
    '#default_value' => '',
    '#weight' => 2.5,
);

  $form['max_amount'] = array(
    '#type' => 'textfield',
    '#attributes' => array(
        ' type' => 'number', // insert space before attribute name :)
    ),
    '#title' => t('Max Amount'),
    '#maxlength' => 10,
    '#default_value' => '',
    '#weight' => 2.6,
);


  $form['photo_id'] = array(
    '#type' => 'textfield',
    '#title' => t('Photo ID'),
    '#maxlength' => 15,
    '#default_value' => '',
    '#weight' => 2.61,
);


  $form['synced'] = array('#type' => 'checkbox', '#title' => 'Synced', '#weight' => 2.7,'#default_value' => 0);
  $form['not_synced'] = array('#type' => 'checkbox', '#title' => 'Not Synced', '#weight' => 2.8,'#default_value' => 0);
  $form['deleted'] = array('#type' => 'checkbox', '#title' => 'Deleted', '#weight' => 2.9,'#default_value' => 0);
  $form['with_logs'] = array('#type' => 'checkbox', '#title' => 'Having Edit Logs', '#weight' => 2.91,'#default_value' => 0);


	$form['sub1'] = array('#type' => 'submit', '#value' => t('Get Report'), '#weight' => 6.1);
	if ( user_access("sync to tally") && (variable_get('tally_server', '') <> '') )
		$form['sub2'] = array('#type' => 'submit', '#value' => 'Sync to Tally', '#weight' => 6.2);
	if ( user_access("download donor master")  )
		$form['sub3'] = array('#type' => 'submit', '#value' => 'Download Donor Master', '#weight' => 6.3);
	/*if ( user_access("fetch registration data") )
		$form['sub2'] = array('#type' => 'submit', '#value' => t('Fetch Registration Data'), '#weight' => 6.2);
	if ( user_access("process mail queue") )
		$form['sub3'] = array('#type' => 'submit', '#value' => t('Process Email Queue'), '#weight' => 6.3);
	*/

	//$form['#redirect'] = 'donation-report-results';

  $tags_suffix = "";

  if (user_access("create donation tags") || user_access("delete donation tags"))
  {
    if (user_access("create donation tags") && user_access("delete donation tags"))
      $tags_suffix = '<button id="createtags" type="button">Create Selected Tags</button> <button id="deletetags" type="button">Delete Selected Tags</button>';
    elseif (user_access("create donation tags"))
      $tags_suffix = '<button id="createtags" type="button">Create Selected Tags</button>';
    elseif (user_access("delete donation tags"))
      $tags_suffix = '<button id="deletetags" type="button">Delete Selected Tags</button>';

    $form['tags'] = array(
      '#title' => 'Create/Delete Tags',
      '#description' => 'To create, type the tag then press enter to select the same and click "Create Selected Tags". To delete, select tags and click on "Delete Selected Tags" button (multiple tags can be created/deleted at once).',
      '#type' => 'select',
      // '#options' => $tags,
      '#options' => $tags,
      '#weight' => 99,
      '#multiple' => "multiple",
      '#size' => 12,
      '#attributes' => array(
          'id' => 'edit-tags',
      ),
      '#suffix' => $tags_suffix,
    );
  }

  $donation_tags_suffix = "";

  if (user_access("assign donation tags") || user_access("unassign donation tags"))
  {
    if (user_access("assign donation tags") && user_access("unassign donation tags"))
      $donation_tags_suffix = '<button id="assigntags" type="button">Assign Selected</button> <button id="unassigntags" type="button">Unassign Selected</button>';
    elseif (user_access("assign donation tags"))
      $donation_tags_suffix = '<button id="assigntags" type="button">Assign Selected</button>';
    elseif (user_access("unassign donation tags"))
      $donation_tags_suffix = '<button id="unassigntags" type="button">Unassign Selected</button>';

    $form['donation-tags'] = array(
      '#title' => 'Assign/Unassign Tags to Selected Donations',
      '#type' => 'select',
      // '#options' => $tags,
      '#options' => $tags,
      '#weight' => 101,
      '#multiple' => "multiple",
      '#size' => 12,
      '#attributes' => array(
          'id' => 'edit-donation-tags',
      ),
      '#suffix' => $donation_tags_suffix,
    );
  }






	if (isset($form_state['storage'], $form_state['storage']['r_from']))
	{
		$append = "";
		if (user_access('access own donation') && (!user_access('administer donation')))
		{
			$append = " and d.d_createdBy='".$user->uid."'";
		}
		//drupal_set_message("I am called");
		$data = $form_state['storage'];
		//drupal_set_message(print_r($data,true));
		$from = $data['r_from'];
		$to = $data['r_to'];
		$foreign = $data['r_foreign'];
		$category = $data['r_category'];
    $id_type = $data['r_id_type'];
		$txn_type = $data['r_type'];
    $don_tags = $data['r_tags'];
		$course = $data['r_course'];
		//$receipt = str_replace( variable_get('receipt_prefix', ''), '' ,$data['r_receipt']);
		$receipt = $data['r_receipt'];
		$donor = $data['r_name'];
		if ( isset($data['r_user']) )
		   $r_user = $data['r_user'];
		else
		   $r_user = '';

     $min_amount = $data['min_amount'];
     $max_amount = $data['max_amount'];

     $photo_id = trim($data['photo_id']);

     $synced = $data['synced'];
     $not_synced = $data['not_synced'];
     $deleted = $data['deleted'];
     $with_logs = $data['with_logs'];
		
		// R6 (donor versioning): donor columns are those of each donation's financial year (snapshot, else current),
		// including Mobile and Email (what a resend uses, U2). All filters are bound (donation_report_where).
		if (!donation_versioning_require(NULL, 'read'))
			return $form;
		$wdata = array('from' => $from, 'to' => $to, 'foreign' => $foreign, 'category' => $category, 'id_type' => $id_type,
			'txn_type' => $txn_type, 'don_tags' => $don_tags, 'course' => $course, 'receipt' => $receipt, 'name' => $donor,
			'user' => $r_user, 'min_amount' => $min_amount, 'max_amount' => $max_amount, 'photo_id' => $photo_id,
			'synced' => $synced, 'not_synced' => $not_synced, 'deleted' => $deleted, 'with_logs' => $with_logs);
		$args = array();
		$q = "SELECT '' AS 'Tags', d.d_synced_date AS 'Synced_Date', CONCAT(d.d_id,'||',d.d_synced,'||',d.d_deleted) AS 'Action 1',
			CONCAT(d.d_id,'||',d.d_synced,'||',d.d_deleted,'||',d.d_update_count) AS 'Action 2', d.d_receipt_email AS 'Action 3',
			d.d_date AS 'Txn Date', c.c_type AS 'Course',
			CONCAT(COALESCE(dv.dv_name, don.d_name), '||', IFNULL(COALESCE(dv.dv_address_proof, don.d_address_proof), ''),
				'||', IF(dv.dv_id IS NULL, '', d.d_fy)) AS 'Name',
			COALESCE(dv.dv_address, don.d_address) AS 'Address', COALESCE(dv.dv_contact, don.d_contact) AS 'Mobile',
			d.d_type AS 'Txn Type', d.d_category AS 'Category',
			CONCAT(d.d_id,'||',d.d_receipt_f,'||',d.d_receipt) AS 'Receipt No',
			COALESCE(dv.dv_id_no, don.d_id_no) AS 'Passport/ID No', COALESCE(dv.dv_email, don.d_email) AS 'Email',
			$txn_types_qry
			d.d_ref_no AS 'Ref No', d.d_currency AS 'Currency', IF(d.d_foreign,'Yes','') AS 'Foreign', d.d_comment AS 'Comment',
			u.name AS 'CreatedBy', d.d_created AS 'Created On', CONCAT(ud.name, '||', d.d_deleted_date) AS 'Extra'
			FROM dh_donation d LEFT JOIN dh_donor don ON d.d_donor = don.d_id" . donation_donor_fy_join('d') . "
			LEFT JOIN users u ON d.d_createdBy = u.uid LEFT JOIN dh_course c ON d.d_course = c.c_id
			LEFT JOIN users ud ON d.d_deleted_by = ud.uid LEFT JOIN dh_donation_tag dt ON d.d_id = dt.dt_donation
			WHERE d.d_id > 0" . donation_report_where($wdata, TRUE, 'num_or_f', $args) . "
			ORDER BY d.d_date DESC, d.d_receipt_f DESC";
		$result = db_query($q, $args);

		// R7: totals grouped by the effective ID type (date range and own-donations restriction only, as before)
		$targs = array();
		$q_typewise = "SELECT COALESCE(dv.dv_id_type, don.d_id_type) AS 'ID-Type-Code', it.it_name AS 'ID-Type-Name',
			d.d_foreign AS 'Foreign', SUM(d.d_amount) AS 'Amount-Sum'
			FROM dh_donation d LEFT JOIN dh_donor don ON d.d_donor = don.d_id" . donation_donor_fy_join('d') . "
			LEFT JOIN dh_id_types it ON it.it_code = COALESCE(dv.dv_id_type, don.d_id_type)
			WHERE d.d_deleted = '0'" . donation_report_where(array('from' => $from, 'to' => $to, 'category' => 'all', 'id_type' => 'all'), TRUE, 'num_or_f', $targs) . "
			GROUP BY COALESCE(dv.dv_id_type, don.d_id_type), d.d_foreign";
		$result_typewise = db_query($q_typewise, $targs);

		if ($result->rowCount() <= 0)
			$form['out'] = array('#markup' => '<div class="report-status"><h2>'.t('No transactions found').'!</h2></div>', '#weight' => 100);
		else
		{
			$total_recs = $result->rowCount();
			$headers_done = false;
			$rows = array();
			while ( $row = $result->fetchAssoc() ) 
			{
        $synced_date = $row['Synced_Date'];
        unset($row['Synced_Date']);

				if (! $headers_done )
				{
					$headers = array_keys($row);
					$headers_done = true;
				}
				// Stored XSS: donor and donation text (often from public DIPI registration) is escaped here; the columns
				// rebuilt as HTML below (links, tags, actions) escape their own text.
				foreach ($row as $k => $v)
					if (!in_array($k, array('Tags', 'Action 1', 'Action 2', 'Action 3', 'Receipt No', 'Name', 'Extra'), TRUE))
						$row[$k] = check_plain((string) $v);
				$vals = array_values($row);
				$temp = explode("||", $row['Receipt No']);
				$receipt_f = $temp[1];

        $row['Tags'] = "";
        if (user_access("view donation tags"))
          $row['Tags'] .= '<a class="view-tags" id="'.$temp[0].'-viewtag" href="#">ViewTags</a><br>';

        if (user_access("assign donation tags") || user_access("unassign donation tags"))
          $row['Tags'] .= '<input type="checkbox" class="donation-tags" name="'.$temp[0].'" value="'.$temp[1].'">';

				if ( isset($temp[2]) && ($temp[2] <> ''))
				{
					//$a = variable_get('receipt_prefix', '').str_pad($temp[0], 7, "0", STR_PAD_LEFT);
					$row['Receipt No'] = l($temp[1], "download-receipt/".$temp[0], 
						array('attributes' => array('class' => array('receipt-file'), 'data-title' => $temp[1] )));

				}
				else
					$row['Receipt No'] = check_plain($temp[1]); //variable_get('receipt_prefix', '').str_pad($temp[0], 7, "0", STR_PAD_LEFT);
				$temp = explode("||", $row['Action 1']);
				$row_deleted = $temp[2];
				if (user_access('edit own donation') || user_access('administer donation'))
				{
					if (($temp[1] == 0) && (!$row_deleted))
						$row['Action 1'] = l(t("Edit"), "donation/edit/".$temp[0]);
          else if ( ($row['Txn Type'] <> 'razorpay') && ($temp[1] == 1) && user_access('edit delete after tally sync') && (!$row_deleted))
            $row['Action 1'] = l(t("Edit"), "donation/edit/".$temp[0])."\nSynced: ".$synced_date;
					else
						$row['Action 1'] = t('Synced');					
				}
				else
					$row['Action 1'] = t('No Access');

				$temp = explode("||", $row['Action 2']);
				// The cancel dialog posts this token with the cancelled reason.
				$delete_attr = array('attributes' => array('class' => array('delete-transaction'), 'data-token' => drupal_get_token('donation-cancel-'.$temp[0]), 'data-receipt' => $receipt_f));
				if (user_access('delete transaction') || user_access('administer donation'))
				{
					if (($temp[1] == 0) && (!$row_deleted))
						$row['Action 2'] = l(t("Delete"), "donation/delete/".$temp[0], $delete_attr );
          else if ( ($row['Txn Type'] <> 'razorpay') &&  ($temp[1] == 1) && user_access('edit delete after tally sync') && (!$row_deleted))
            $row['Action 2'] = l(t("Delete"), "donation/delete/".$temp[0], $delete_attr )."\nSynced: ".$synced_date;
					else
						$row['Action 2'] = t('Synced');					
				}
				else
					$row['Action 2'] = t('No Access');

				if ($row['Action 3'])
				{
					// A cancelled receipt is not sent again; its log stays viewable.
					$row['Action 3'] = '';
					if (!$row_deleted)
					{
						$row['Action 3'] = l("Email", "/send-email/".$temp[0], array('attributes' => array('class' => array('send-email'), 'action-type' => 'email', 'did' => $temp[0] )) );
						$row['Action 3'] .= "\n".l("Whatsapp", "/send-whatsapp/".$temp[0], array('attributes' => array('class' => array('send-whatsapp' ), 'action-type' => 'whatsapp', 'did' => $temp[0] )) );
						// M12: reprint with the donor details of the donation's financial year (old PDF archived first)
						if (($row['Txn Type'] <> 'razorpay') && donation_reprint_access())
							$row['Action 3'] .= "\n".l(t('Reprint'), 'donation/reprint/'.$temp[0]);
					}
					if (isset($temp[3]) && ($temp[3] > 0) )
					{
						$row['Action 3'] = ltrim($row['Action 3']."\n".l("View Log", "/view-log/".$temp[0], array('attributes' => array('target' => '_blank'))));
					}
				}

				$temp = explode("||", $row['Name']);
				//$tt = explode(" ", trim($temp[0]) );
				if ( isset($temp[1]) && ($temp[1] <> '') )
				{
					$row['Name'] = l(trim($temp[0]), file_create_url($temp[1]), 
						array('attributes' => array('class' => array('address-proof'), 'data-title' => $temp[0] )));
				}
				else
					$row['Name'] = check_plain(trim($temp[0]));
				// L28: the donation's financial year uses its own donor details (snapshot)
				if (isset($temp[2]) && $temp[2] !== '')
					$row['Name'] = array('data' => $row['Name'], 'class' => array('fy-own'),
						'title' => t('FY @f uses its own donor details', array('@f' => donation_fy_label((int) $temp[2]))));

				/*$temp = explode("||", $row['Last Name']);
				if ( isset($temp[1]) && ($temp[1] <> '') )
				{
					$row['Last Name'] = l($tt[1], file_create_url($temp[1]), 
						array('attributes' => array('class' => array('address-proof'), 'data-title' => $temp[0] )));
				}
				else
				{
					if (isset($tt[1]))
						$row['Last Name'] = $tt[1];
				}*/

				if ( $row['Course'] == '' )
					$row['Course'] = 'Non Course';

				if ( $row_deleted )
				{
					$t = explode("||", $row['Extra']);
					$row['Extra'] = check_plain("Deleted by ".$t[0]." on ".(isset($t[1]) ? $t[1] : ''));
				}
				else
					$row['Extra'] = '';
                foreach( $txn_types_totals as $t )
                {
                        if ( ! isset($totals[ $t ][$row['Currency']]) )
                                $totals[ $t ][$row['Currency']] = 0;
                        if ( ! $row_deleted )
                        	  if (is_numeric($row[$t]))
                            	$totals[ $t ][$row['Currency']] += $row[ $t ];
                }
				
				/*if ( ! isset($totals['Cash'][$row['Currency']]) )
					$totals['Cash'][$row['Currency']] = 0;
				if ( ! isset($totals['Cheque'][$row['Currency']]) )
					$totals['Cheque'][$row['Currency']] = 0;
				if ( ! isset($totals['Card'][$row['Currency']]) )
					$totals['Card'][$row['Currency']] = 0;
				if ( ! isset($totals['Bank Transfer'][$row['Currency']]) )
					$totals['Bank Transfer'][$row['Currency']] = 0;
				
				$totals['Cash'][$row['Currency']] += $row['Cash'];
				$totals['Cheque'][$row['Currency']] += $row['Cheque'];
				$totals['Card'][$row['Currency']] += $row['Card'];
				$totals['Bank Transfer'][$row['Currency']] += $row['Bank Transfer'];
				*/
                if ( $row_deleted )
                    $rows[] = array('data' => $row, 'class' => array('deleted'));
                else
                    $rows[] = $row;			
			}
			$row = array();
			$grand_total = array();
			foreach( $headers as $v )
			{
				if( in_array($v,$txn_types_totals) )    /// array('Cash','Cheque','Card', 'Bank Transfer')))
				{
					$temp = '';
					foreach($totals[$v] as $cur => $tot)
					{
						if ($tot > 0)
						{
							$temp .= number_format($tot).' '.$cur.'<br>';
							if ( !isset($grand_total[ $cur ]) )
							   $grand_total[ $cur ] = 0;
							$grand_total[ $cur ] += $tot;
						}
					}
					$row[] = $temp;
				}
				else
					$row[] = '';
			}
			$rows[] = $row;
			$temp = '';
			foreach( $grand_total as $cur => $total )
			   $temp .= number_format($total).' '.$cur.'<br>';
			
			$out = '<div class="report-status"><h2>'.$total_recs.t(' transactions(s) found').'!</h2></div>';
			$out .= '<h4>'.l(t("Download as Excel"), "donation-report/excel", 
				array('query' => array('start' => $from, 'end' => $to, 'foreign' => $foreign, 'category' => $category,
          'id_type' => $id_type,
          'txn_type' => $txn_type,
          'don_tags' => $don_tags,
          'min_amount' => $min_amount, 'max_amount' => $max_amount,
          'photo_id' => $photo_id,
          'synced' => $synced, 'not_synced' => $not_synced, 'deleted' => $deleted, 'with_logs' => $with_logs,
							'course' => $course, 'name' => $donor, 'receipt' => $receipt, 'user' => $r_user)) ).'</h4>';
			$out .= theme('table',array('header' => $headers, 'rows' => $rows));
			$out .= '<div style="text-align: center"><h2> '.t('Grand Total').': '.$temp.'</h2></div>';
			//drupal_set_message($out);
			$form['out'] = array('#markup' => $out, '#weight' => 100 );
			
		}

        $out_typewise = '<br><h2>Total amount grouped by ID type for given date range (without any other search parameters).</h2><br>';
        if ($result_typewise->rowCount() <= 0)
        {
            $out_typewise .= 'No result found.';
        }
        else
        {
            while ( $row_typewise = $result_typewise->fetchAssoc())
                $rows_typewise[] = array_map('check_plain', $row_typewise);

            $headers_typewise = array('ID-Type-Code', 'ID-Type-Name', 'Foreign', 'Amount-Sum');
            $table_typewise = theme('table',array('header' => $headers_typewise, 'rows' => $rows_typewise));
            $out_typewise .= $table_typewise;
        }

        $form['out-typewise'] = array('#markup' => $out_typewise, '#weight' => 102 );

	}



