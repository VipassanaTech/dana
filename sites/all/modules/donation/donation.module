	$perms['assign donation tags'] = array("title" => 'Assign Donation Tags');
	$perms['unassign donation tags'] = array("title" => 'Unassign Donation Tags');
	$perms['access donor'] = array('title' => t('Access Donor Details') );
    $perms['download receipt'] = array("title" => 'Download Receipt');
	$perms['view donors'] = array('title' => t('View Donors') );
